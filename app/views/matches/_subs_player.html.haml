.match-player-item
  .match-player-avatar
    .player-show-face
      %img{ src: match_player.player.avatar_path, onerror: "this.onerror=null;this.src='#{image_path('avatar.png')}'" }
    .player-show-kit
      - if match_player.lineup.tour.national?
        %img{ src: match_player.player.national_kit_path, onerror: "this.onerror=null;this.src='#{image_path('kit_small_default.png')}'" }
      - else
        %img{ src: match_player.kit_path, onerror: "this.onerror=null;this.src='#{image_path('kit_small_default.png')}'" }
  .match-player-data
    .match-player-data
      .match-player-data-base
        = link_to player_path(match_player.player) do
          .team-player-name
            = match_player.player.full_name_reverse
            = image_tag('icons/subs-off.svg') if match_player.get_out?
            .team-player-score-unspecified.inline-block
              - if match_player.lineup.tour.national?
                = match_player.player.national_team&.name
              - else
                = match_player.player.club&.name
        - if match_player.score.positive?
          .team-player-scores{ class: ('team-player-scores--live' if match_player.live?) }
            .team-player-score= match_player.score
            .team-player-total-score= match_player.total_score
        - elsif match_player.live? && match_player.round_player_in_squad?
          .team-player-score-live-pending –
        - elsif match_player.live?
          .team-player-score-live-absent{ title: t('matches.not_in_squad') }= t('matches.not_in_squad')
        - elsif match_player.club_played_match? || (match_player.tour.mantra? && match_player.another_tournament?)
          .team-player-score-not-played= t('matches.didnt_play')
        - else
          .team-player-score-unspecified= t('matches.unspecified')
      .match-player-add-data
        - if match_player.club_played_match?
          .match-player-bonuses
            = render 'matches/mp_bonuses', match_player: match_player
        - elsif !match_player.lineup.tour.national?
          = render 'matches/real-match', match_player: match_player, t_round: match_player.tour.tournament_round
        - else
          %div
        .match-player-positions
          .player-positions-block
            - match_player.player.positions.each do |position|
              .player-position{class: "player-position-#{position.name}"}
                = position_name(position)
