.right-nav.active-right-nav-true.manage-nav
  .league-name= t('manage.nav.title')
  - manage_nav_items.each do |ctrl, path, icon, label_key|
    .league-links
      = link_to path do
        .league-link{ class: "link-active-#{params[:controller] == ctrl}" }
          .league-link-icon= image_tag(icon)
          .league-link-text= t(label_key)

