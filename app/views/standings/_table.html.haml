- compact = local_assigns.fetch(:compact, false)
- opponents = local_assigns[:opponents]
- live_results = local_assigns.fetch(:live_results, {})
- if standings.present?
  %table.standings-table{ class: ('standings-table--compact' if compact) }
    %thead
      %tr
        %th.standings-pos= t('tours.standings_pos')
        %th.standings-team= t('tours.standings_team')
        %th= t('tours.standings_played')
        %th= t('tours.standings_wins')
        %th= t('tours.standings_draws')
        %th= t('tours.standings_losses')
        - unless compact
          %th.standings-goals= t('tours.standings_goals')
        %th.standings-points= t('tours.standings_points')
        - if opponents
          %th.standings-opponent= t('tours.standings_opponent')
    %tbody
      - standings.each do |standing|
        - live = live_results[standing.club_id]
        - live_cell = "standings-live standings-live--#{live}" if live
        %tr{ data: (opponents ? { club_id: standing.club_id, opponent_id: opponents[standing.club_id]&.id } : {}) }
          %td.standings-pos
            %span.standings-zone{ style: ("background-color: #{standing.zone_color}" if standing.zone_color.present?) }
            = standing.position
          %td.standings-team
            .standings-team-inner
              - if standing.club
                .standings-club-logo
                  %img{ src: standing.club.logo_path, onerror: "this.onerror=null;this.src='#{image_path('default_logo.png')}'" }
              %span.standings-club-name
                = compact && standing.club ? standing.club.code : standing.display_name
          %td{ class: live_cell }= standing.played
          %td{ class: live_cell }= standing.wins
          %td{ class: live_cell }= standing.draws
          %td{ class: live_cell }= standing.losses
          - unless compact
            %td.standings-goals{ class: live_cell }= standing.scores_str
          %td.standings-points{ class: live_cell }= standing.points
          - if opponents
            %td.standings-opponent
              - opponent = opponents[standing.club_id]
              - if opponent
                .standings-club-logo{ title: opponent.name }
                  %img{ src: opponent.logo_path, onerror: "this.onerror=null;this.src='#{image_path('default_logo.png')}'" }
              - else
                %span.standings-opponent-none —
