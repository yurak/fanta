- players_by_slot = @weekly_team.weekly_team_players.index_by(&:slot_id)
- auction = @weekly_team.source_auction?
- national = players_by_slot.values.first&.round_player&.tournament_round&.tournament&.national? || false

.page-block.lineup-show-page
  .web-header= render 'layouts/left_nav', league: nil
  .mob-header= render 'layouts/mob_header', league: nil, title: "#{auction ? t('weekly_team.title_auction_short') : t("weekly_team.title_#{@weekly_team.mode}_short")} ##{@weekly_team.number}"

  .page-info.match-page.lineup-page.weekly-team-page
    .weekly-team-content
      .weekly-team-title
        = "#{auction ? t('weekly_team.title_auction') : t("weekly_team.title_#{@weekly_team.mode}")} ##{@weekly_team.number}"

      .lineup-squad.match-squads
        .match-team-squad
          .match-team-data
            .match-team-module
              .match-team-data-text= t('matches.module')
              .match-team-data-value= @weekly_team.team_module.name
            - unless @weekly_team.source_avg? || auction
              .match-team-def-bonus
                .match-team-data-text= t('matches.def_bonus')
                .match-team-data-value= @weekly_team.defence_bonus
          .match-main-squad
            - @weekly_team.team_module.slots.sort_by(&:number).each do |slot|
              - wtp = players_by_slot[slot.id]
              .match-player-item
                .match-player-avatar
                  - if wtp
                    .player-show-face
                      %object{data: wtp.resolved_player.avatar_path, type: ApplicationRecord::CONTENT_TYPE_PNG}
                        = image_tag('avatar.png')
                    .player-show-kit
                      - if national
                        %object{data: wtp.resolved_player.national_kit_path, type: ApplicationRecord::CONTENT_TYPE_PNG}
                          = image_tag('kit_small_default.png')
                      - else
                        %object{data: wtp.resolved_club&.kit_path, type: ApplicationRecord::CONTENT_TYPE_PNG}
                          = image_tag('kit_small_default.png')
                  .module-position-block.player-positions-block
                    - slot.positions.each do |position|
                      .player-position{class: "player-position-#{position}"}
                        = slot_position_name(position)
                .match-player-data
                  .match-player-data-base
                    - if wtp
                      = link_to player_path(wtp.resolved_player) do
                        .team-player-name
                          = wtp.resolved_player.full_name
                          .team-player-score-unspecified.inline-block
                            - if national
                              = wtp.resolved_player.national_team&.name
                            - else
                              = "#{wtp.resolved_club&.tournament&.icon} #{wtp.resolved_club&.name}"
                      .team-player-scores
                        .team-player-blank
                        - if auction
                          - if wtp.max_price
                            .team-player-score{title: t('weekly_team.max_price')}= '%g' % wtp.max_price
                          .team-player-total-score{title: t('weekly_team.avg_price')}= weekly_team_avg_price(wtp.total)
                        - else
                          - unless @weekly_team.source_avg?
                            .team-player-score= '%.1f' % wtp.round_player.score
                          .team-player-total-score= '%.1f' % wtp.total
                    - else
                      .team-player-score-unspecified —
                  .match-player-add-data
                    - if wtp && !auction
                      .match-player-bonuses
                        - if @weekly_team.source_avg? && @season_bonuses
                          = render 'weekly_teams/season_bonuses', bonuses: @season_bonuses[wtp.round_player.player_id]
                        - else
                          = render 'weekly_teams/rp_bonuses', round_player: wtp.round_player

        .lineup-module
          .lineup-result
            .lineup-result-text= t('weekly_team.total_score')
            .lineup-result-value
              .lineup-result-score= '%.2f' % @weekly_team.total_score
          - wt_slot_name_pairs = @weekly_team.team_module.slots.sort_by(&:number).map { |s| [s, players_by_slot[s.id]&.resolved_player&.name] }
          = render 'lineups/team_field', slot_name_pairs: wt_slot_name_pairs

      - if @round_top_lineups.present?
        .weekly-team-round-tops
          .weekly-team-round-tops-title= t('weekly_team.round_tops_title')
          %table.weekly-team-round-tops-table
            %thead
              %tr
                %th= t('weekly_team.col_tournament')
                %th.text-center= t('weekly_team.col_round')
                %th.text-end= t('weekly_team.col_result')
                %th= t('weekly_team.col_team')
                %th= t('weekly_team.col_manager')
            %tbody
              - @round_top_lineups.each do |round, lineup|
                %tr
                  %td.tournament-cell
                    %span.tournament-flag= round.tournament&.icon
                    = round.tournament&.name
                  %td.text-center= round.number
                  - if lineup
                    %td.text-end= link_to('%.1f' % lineup.total_score, team_lineup_path(lineup.team, lineup))
                    %td.team-cell
                      = image_tag lineup.team.logo_path, class: 'weekly-team-round-tops-logo', alt: ''
                      = lineup.team.human_name
                    %td= lineup.team.user&.name
                  - else
                    %td.text-end —
                    %td —
                    %td —
