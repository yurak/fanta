.page-block
  .web-header= render 'layouts/left_nav', league: nil
  .web-header= render 'layouts/manage_nav'
  .mob-header= render 'layouts/mob_header', league: nil, title: t('manage.champions.title')
  .page-info.admin-manage-page
    %h2= t('manage.champions.title')

    .default-tabs.manage-champions-tabs
      - Manage::ChampionsController::TABS.each do |tab|
        = link_to manage_champions_path(tab: tab), class: "default-tab-item #{'default-tab-active' if @tab == tab}" do
          .default-tab-name= t("manage.champions.tab_#{tab}")

    - if @champions.none?
      %p.text-muted= t('manage.champions.empty')
    - elsif @tab == 'matrix'
      = render 'matrix', matrix: @matrix
    - else
      = render 'list', champions: @champions
