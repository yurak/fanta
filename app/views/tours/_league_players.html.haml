.round-list.round-table-block
  - @league_players.each_with_index do |r_player, i|
    .round-table-item.round-player-stats-item
      .center= i + 1
      .round-player-stats-data
        .round-player-stats-img
          .round-player-show-face
            %img{ src: r_player.player.avatar_path, onerror: "this.onerror=null;this.src='#{image_path('avatar.png')}'" }
          .round-player-show-kit
            %img{ src: tour.national? ? r_player.player.national_kit_path : r_player.kit_path, onerror: "this.onerror=null;this.src='#{image_path('kit_small_default.png')}'" }
        .round-player-stats-name= r_player.player.name
      .round-player-stats-team
        - if (team = @teams_by_player[r_player.id])
          = image_tag(team.logo_path)
      .round-player-stats-score= r_player.total_score
